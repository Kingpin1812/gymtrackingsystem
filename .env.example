# Copy to .env and adjust. Placeholders only - never commit real values.
# Database URL. Leave commented to use gymtrack/data/gymtrack.db (SQLite).
# GYMTRACK_DATABASE_URL=sqlite:///C:/path/to/gymtrack.db
# IANA time zone of the gym. Membership dates and "today" use this zone.
GYMTRACK_TIMEZONE=Asia/Kolkata
# How long a login session stays valid.
GYMTRACK_SESSION_HOURS=12
# Open check-ins older than this are treated as stale (forgotten check-out).
GYMTRACK_STALE_SESSION_HOURS=4
# A repeated check-out within this many seconds returns the same result.
GYMTRACK_CHECKOUT_DEDUPE_SECONDS=120
# Failed logins allowed per email+IP within the window before blocking.
GYMTRACK_LOGIN_MAX_ATTEMPTS=5
GYMTRACK_LOGIN_WINDOW_MINUTES=15
GYMTRACK_LOG_LEVEL=INFO
